<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Snap Auto Opener V3.3 – Manueller Durchlauf"
            android:textStyle="bold"
            android:textSize="28sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nur auf Ihren Startbefehl: bis zu 10 Tipp-Versuche im sichtbaren Chatbereich."
            android:textSize="16sp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/profileStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profilstatus wird geprüft …"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/checkProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Snapchat in diesem Profil prüfen" />

        <Button
            android:id="@+id/notificationAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Benachrichtigungszugriff aktivieren"
            android:layout_marginTop="18dp" />

        <Button
            android:id="@+id/accessibilityAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Bedienungshilfe aktivieren"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/serviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Service-Status wird geprüft …"
            android:textIsSelectable="true"
            android:typeface="monospace"
            android:textSize="13sp"
            android:padding="12dp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/runDiagnostic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diagnose starten"
            android:layout_marginTop="18dp" />

        <Button
            android:id="@+id/copyDiagnostic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diagnose kopieren"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/diagnosticReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Noch keine Diagnose durchgeführt."
            android:textIsSelectable="true"
            android:typeface="monospace"
            android:textSize="12sp"
            android:padding="12dp"
            android:layout_marginTop="10dp" />

        <Switch
            android:id="@+id/enabledSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Neue Snaps automatisch öffnen"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/openExisting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Snaps im Arbeitsprofil öffnen (START)"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/stopBatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STOPP – Durchlauf beenden"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="V3.3 speichert keine Screenshots. Die Farberkennung ist experimentell; falsche Treffer sind möglich."
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>
