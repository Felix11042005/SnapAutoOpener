<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Vorhandenen Snap öffnen: Öffnungsmodus bereitstellen, Snapchat-Chatliste anzeigen und dort START im Bedienfeld drücken. Bei einem erkannten ungeöffneten Snap wird dessen direktes Statusziel angeklickt oder nach zwei gleichen Bildern einmal auf sein gefülltes rotes/violettes Symbol getippt. Spätere Ziele werden nicht ergänzt. Das Verhalten muss am Gerät geprüft werden. Snapchat kann mehrere Snaps derselben Unterhaltung automatisch abspielen."
            android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Snap untersagt nicht autorisierte automatisierte Drittanbieter-Interaktionen. Auch diese Diagnose ist nicht ausdrücklich freigegeben. Live-Nutzung bitte mit Snap klären. Offline-Tests greifen nicht auf Snapchat zu." />
        <TextView android:id="@+id/profileStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
        <Button android:id="@+id/accessibilityAccess" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Bedienungshilfe öffnen" android:layout_marginTop="12dp" />
        <TextView android:id="@+id/serviceStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textIsSelectable="true" />
        <Button android:id="@+id/startSingleSnap" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Öffnungsmodus bereitstellen" android:layout_marginTop="16dp" />
        <Button android:id="@+id/startDiagnostic" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="START – 30 Sekunden Diagnose" android:layout_marginTop="16dp" />
        <Button android:id="@+id/stopDiagnostic" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="STOP – sofort beenden" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Gewünschte Snapchat-Instanz manuell öffnen. Im Öffnungsmodus START über der sichtbaren Chatliste drücken. Fehlender oder unklarer Bestand beendet den Versuch sofort; es wird nicht auf neue Snaps gewartet. STOP bleibt im Bedienfeld erreichbar. Vorbereitung und Öffnungsversuch haben jeweils 30 Sekunden Zeitlimit. Prüfe, ob tatsächlich der gewünschte Snap angezeigt wird."
            android:layout_marginTop="12dp" />
        <Button android:id="@+id/copyDiagnostic" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Diagnose kopieren" android:layout_marginTop="12dp" />
        <Button android:id="@+id/resetDiagnostic" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="STOP und Diagnose löschen" />
        <TextView android:id="@+id/diagnosticReport" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textIsSelectable="true" android:typeface="monospace" android:textSize="12sp"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
